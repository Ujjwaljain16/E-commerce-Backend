{
  "uid": "ecommerce-services",
  "title": "E-commerce services",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(grpc_requests_total, service)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "gRPC requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (service) (rate(grpc_requests_total{service=~\"$service\"}[1m]))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "gRPC server error ratio",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(grpc_requests_total{service=~\"$service\",status=~\"Internal|Unavailable|DeadlineExceeded|Unknown\"}[5m])) / sum by (service) (rate(grpc_requests_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "gRPC p95 latency",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(grpc_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Gateway HTTP requests by status",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_requests_total{service=\"graphql-gateway\"}[1m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kafka messages",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (topic) (rate(kafka_messages_produced_total[1m]))", "legendFormat": "produced {{topic}}" },
        { "refId": "B", "expr": "sum by (service, status) (rate(kafka_messages_consumed_total[1m]))", "legendFormat": "consumed {{service}} {{status}}" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Product cache hit ratio (1h)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cache_hits_total[1h])) / (sum(increase(cache_hits_total[1h])) + sum(increase(cache_misses_total[1h])))"
        }
      ]
    }
  ]
}
