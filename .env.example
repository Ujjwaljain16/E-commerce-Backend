# Copy to .env (gitignored) to run docker compose with Razorpay instead of the mock provider.
# Use TEST mode keys from the Razorpay dashboard (they start with rzp_test_). Never commit real keys.

PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
# The secret you type when creating the webhook in the dashboard (not the API key secret).
RAZORPAY_WEBHOOK_SECRET=replace-me

# Razorpay charges in INR; catalog prices are then read as paise.
CURRENCY=INR

# How long a customer has to finish Checkout before the order is cancelled.
PAYMENT_TIMEOUT=30m
